# データベース
DATABASE_URL="postgresql://movie_prf:password@localhost:5433/movie_prf"  # 本番: <RDSエンドポイント>に変更

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-change-in-production"

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_DEFAULT_REGION="ap-northeast-1"
AWS_BUCKET="movie-prf"
AWS_ENDPOINT="http://localhost:9000"
AWS_URL="http://localhost:9000"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# アプリケーション
NODE_ENV="development"           # 本番: production
PORT=3000
FRONTEND_URL="http://localhost:5173"  # 本番(EC2単体): https://node.hozu.click
                                      # 本番(ALB構成): https://node.hozu.click
TRUST_PROXY=false                # 本番(ALB構成): true  ※ALBのX-Forwarded-Protoを信頼するために必要
