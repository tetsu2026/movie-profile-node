# =================================
# 本番環境設定（AWS EC2用）
# =================================
# このファイルを .env にコピーして値を設定:
#   cp .env.production.example .env

# データベース（RDS）
DATABASE_URL="mysql://ユーザー名:パスワード@RDSエンドポイント:3306/movie_prf"

# JWT
JWT_SECRET="本番用の強力なランダム文字列を設定"
JWT_REFRESH_SECRET="本番用の強力なランダム文字列を設定"

# AWS S3（実AWS。AWS_ENDPOINTは設定しない）
AWS_ACCESS_KEY_ID="IAMアクセスキー"
AWS_SECRET_ACCESS_KEY="IAMシークレットキー"
AWS_DEFAULT_REGION="ap-northeast-1"
AWS_BUCKET="S3バケット名"
# AWS_ENDPOINT は設定しない（実AWS S3を使用）
AWS_URL="https://S3バケット名.s3.ap-northeast-1.amazonaws.com"

# Redis（EC2ローカル）
REDIS_HOST="localhost"
REDIS_PORT=6379

# アプリケーション
NODE_ENV="production"
PORT=3000
FRONTEND_URL="http://<EC2パブリックIP>:8080"
